pipeline {
    agent any

    environment {
        ANSIBLE_CONFIG = "${WORKSPACE}/ansible.cfg"
        ANSIBLE_HOST_KEY_CHECKING = 'False'
        // Define variable for the dynamic backup name
        BACKUP_NAME = ""
    }

    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Backup FortiGate State') {
            steps {
                script {
                    // 1. Generate a filename with a timestamp
                    def timeStamp = sh(returnStdout: true, script: 'date +%Y%m%d%H%M%S').trim()
                    env.BACKUP_NAME = "fgt_rollback_point_${timeStamp}.conf"
                }

                echo "Creating FGT rollback point: ${env.BACKUP_NAME}"

                withCredentials([
                    file(credentialsId: 'ansible-vault-pass', variable: 'VAULT_PASS_FILE')
                ]) {
                    // We only need the Vault pass because the API token is inside the Vault
                    sh '''
                        ansible-playbook -i inventory/hosts_forti.ini \
                        playbooks/forti_config.yml \
                        --tags "backup" \
                        -e "custom_backup_filename=${BACKUP_NAME}" \
                        --vault-password-file $VAULT_PASS_FILE
                    '''
                }
            }
        }

        stage('Deploy FGT Configuration') {
            steps {
                withCredentials([
                    file(credentialsId: 'ansible-vault-pass', variable: 'VAULT_PASS_FILE')
                ]) {
                    sh '''
                        ansible-playbook -i inventory/hosts_forti.ini \
                        playbooks/forti_config.yml \
                        --tags "config" \
                        --vault-password-file $VAULT_PASS_FILE
                    '''
                }
            }

            post {
                failure {
                    echo "FGT Deployment Failed! Initiating Rollback..."
                    withCredentials([
                        file(credentialsId: 'ansible-vault-pass', variable: 'VAULT_PASS_FILE')
                    ]) {
                        // Note: FortiGate rollback usually requires a full config restore
                        sh '''
                            echo "Rolling back FGT to: backups/${BACKUP_NAME}"

                            ansible-playbook -i inventory/hosts_forti.ini \
                            playbooks/forti_restore.yml \
                            -e "restore_file=${WORKSPACE}/backups/${BACKUP_NAME}" \
                            --vault-password-file $VAULT_PASS_FILE
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            // Archive the .conf files generated by the FortiGate backup
            archiveArtifacts artifacts: 'backups/*.conf', allowEmptyArchive: true
            cleanWs()
        }
    }
}
