pipeline {
    agent any

    environment {
        ANSIBLE_CONFIG = "${WORKSPACE}/ansible.cfg"
        ANSIBLE_HOST_KEY_CHECKING = 'False'
    }

    stages {

        // --- NEW FILTERING LOGIC ---
        stage('Deploy FortiGate') {
            when {
                anyOf {
                    changeset "playbooks/forti_*"
                    changeset "inventory/hosts_forti.ini"
                    changeset "Jenkinsfile-FGT"
                }
            }
            stages {
                stage('Backup FortiGate State') {
                    steps {
                        script {
                            def timeStamp = sh(returnStdout: true, script: 'date +%Y%m%d%H%M%S').trim()
                            env.BACKUP_NAME = "fgt_rollback_point_${timeStamp}.conf"
                        }
                        echo "Creating FGT rollback point: ${env.BACKUP_NAME}"
                        withCredentials([file(credentialsId: 'ansible-vault-pass', variable: 'VAULT_PASS_FILE')]) {
                            sh """
                                ansible-playbook -i inventory/hosts_forti.ini \
                                playbooks/forti_config.yml \
                                --tags backup \
                                -e "custom_backup_filename=${env.BACKUP_NAME}" \
                                -e "workspace_backup_path=${WORKSPACE}/backups" \
                                --vault-password-file $VAULT_PASS_FILE
                            """
                        }
                    }
                }

                stage('Deploy FGT Configuration') {
                    steps {
                        withCredentials([file(credentialsId: 'ansible-vault-pass', variable: 'VAULT_PASS_FILE')]) {
                            sh '''
                                ansible-playbook -i inventory/hosts_forti.ini \
                                playbooks/forti_config.yml \
                                --tags config \
                                --vault-password-file $VAULT_PASS_FILE
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'backups/*.conf', allowEmptyArchive: true
            cleanWs()
        }
    }
}
